# Copie para terraform.tfvars (ignorado pelo Git) e preencha. Este arquivo tem segredos: não compartilhe.

region      = "us-east-2" # Ohio: a organização da conta só libera esta região (mesmo preço de us-east-1)
environment = "prod"

# Alertas de custo (recomendado em conta free tier)
alert_email        = "seu-email@exemplo.com"
monthly_budget_usd = 15

# Domínio próprio com HTTPS (opcional). Sem ele, o console fica em http://<dns-do-alb>.
# domain_name     = "argos.seudominio.com.br"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Modelos da Lia: principal + fallbacks (de preferência em provedores diferentes).
llm_routes = {
  primary = {
    base_url         = "https://api.groq.com/openai/v1"
    model            = "openai/gpt-oss-120b"
    reasoning_effort = "low"
  }
  fallback1 = {
    base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
    model    = "gemini-flash-lite-latest"
  }
  fallback2 = {
    base_url         = "https://api.groq.com/openai/v1"
    model            = "openai/gpt-oss-20b"
    reasoning_effort = "low"
  }
}

llm_api_keys = {
  primary   = "gsk_..." # chave NOVA do Groq (revogue a usada no desenvolvimento)
  fallback1 = "AIza..." # chave do Google AI Studio (Gemini)
  fallback2 = "gsk_..."
}

# Embeddings da busca vetorial (sem ela, a Lia usa só a busca textual) e rerank (opcional).
openai_api_key = "sk-..."
cohere_api_key = ""

# E-mail via Amazon SES (opcional).
# smtp_host     = "email-smtp.us-east-2.amazonaws.com"
# smtp_username = "AKIA..."
# smtp_password = "..."
# mail_from     = "noreply@seudominio.com.br"

# Liga/desliga para apresentações: guarda os dados num snapshot ao destruir e restaura na próxima vez.
db_skip_final_snapshot = false
# db_snapshot_identifier = "argos-prod-final-xxxxxx" # nome mostrado por terraform output db_final_snapshot_name

# Capacidade (padrões econômicos). Para produção real: backend_cpu = 1024, backend_memory = 2048,
# backend_desired_count = 2, db_multi_az = true, db_deletion_protection = true, db_skip_final_snapshot = false.
