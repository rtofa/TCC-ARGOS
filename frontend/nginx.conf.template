# Template processado pelo entrypoint do nginx (envsubst) na subida do container.
# API_UPSTREAM: para onde /api e encaminhado. No docker-compose, o servico "backend"; na AWS, o proprio ALB
# (que ja roteia /api/* direto ao backend, entao este bloco so atende chamadas que cheguem ao nginx).
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Mesma origem do navegador: o console chama /api e o nginx encaminha ao backend (sem CORS).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Respostas da Lia em streaming (SSE) podem levar ate ~2 minutos.
        proxy_read_timeout 130s;
        client_max_body_size 12m;
    }

    # Assets com hash no nome podem ficar em cache; o index.html nao.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Aplicacao de pagina unica: rotas do React caem no index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
